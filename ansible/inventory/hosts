# ============================================================
# Inventaire Ansible — K3s Cluster
# ============================================================
# Utilisation : ansible-playbook -i inventory/hosts site.yml

# Serveur K3s (Master)
[k3s_servers]
k3s-server-01 ansible_host=10.0.1.50 ansible_user=ubuntu ansible_port=22

# Agents K3s (Workers)
[k3s_agents]
k3s-agent-01 ansible_host=10.0.10.51 ansible_user=ubuntu ansible_port=22
k3s-agent-02 ansible_host=10.0.20.52 ansible_user=ubuntu ansible_port=22
k3s-agent-03 ansible_host=10.0.30.53 ansible_user=ubuntu ansible_port=22

# Tous les nœuds K3s
[k3s_cluster:children]
k3s_servers
k3s_agents

# Serveurs d'application (workers avec label app)
[app_servers:children]
k3s_agents

# Serveurs de monitoring
[monitoring_servers:children]
k3s_servers

# Variables communes à tous les hôtes
[k3s_cluster:vars]
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3
k3s_cluster_name=devops-project-cluster
k3s_version=v1.30.4+k3s1
k3s_token=CHANGE_ME_SECRET_TOKEN
db_host=10.0.10.100
db_port=3306
db_name=gestion_demandes
db_user=app
db_password=CHANGE_ME_DB_PASSWORD
base_url=/devops-project